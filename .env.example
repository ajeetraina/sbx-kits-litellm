# Copy to `.env` (gitignored) and fill in the providers you want to route.
# `docker compose up -d` loads this file automatically; keys stay out of
# your shell history and are scoped to the compose project.

# Virtual key the sandbox authenticates with. Must match the kit's
# LITELLM_MASTER_KEY / OPENAI_API_KEY. Not a provider secret.
LITELLM_MASTER_KEY=sk-sandbox-litellm

# Real provider credentials — only the ones you use are required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Router image. Defaults to the LiteLLM Docker Hardened Image (dhi.io/litellm:1).
# Override to pin a tag or use a different image, e.g.:
# LITELLM_IMAGE=dhi.io/litellm:1.94.0-debian13
